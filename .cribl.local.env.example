# Copy to .cribl.local.env and fill in the API credential.
# Create the credential in Cribl.Cloud: Organization, then API Credentials.
# The client secret is shown once. Do not commit .cribl.local.env.

CRIBL_BASE_URL=https://your-workspace.cribl.cloud
CRIBL_CLIENT_ID=
CRIBL_CLIENT_SECRET=
CRIBL_APP_ID=search-dataset-access-manager-v1
